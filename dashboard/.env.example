DATABASE_URL=postgresql://postgres:password@host:5432/railway
DISCORD_CLIENT_ID=replace_with_your_application_client_id
DISCORD_CLIENT_SECRET=replace_with_your_discord_oauth_client_secret
DISCORD_BOT_TOKEN=replace_with_your_bot_token
DISCORD_GUILD_ID=replace_with_your_guild_id
DISCORD_MOD_ROLE_IDS=role_id_one,role_id_two
# Optional: Kommagetrennte Discord-User-IDs mit Dashboard-Zugang, unabhängig von Rollen.
DASHBOARD_ALLOWED_USER_IDS=
DASHBOARD_URL=http://localhost:5173
SESSION_SECRET=generate_a_long_random_value
# Railway Bucket: Die Werte können über "Add Variables" mit dem AWS-SDK-Preset automatisch aus dem Bucket übernommen werden.
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_ACCESS_KEY_ID=replace_with_bucket_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_bucket_secret_access_key
AWS_S3_BUCKET_NAME=replace_with_generated_bucket_name
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual