DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_client_id
DISCORD_GUILD_ID=
# Kommagetrennte Rollen-IDs mit Bot-Zugriff. Administratoren haben immer Zugriff.
DISCORD_MOD_ROLE_IDS=replace_with_mod_role_id
DISCORD_WHISPER_CHANNEL_ID=
WHISPER_MIN_HOURS=24
WHISPER_MAX_HOURS=32
# Optionaler beschreibbarer Pfad für die persistente State-Datei.
WHISPER_STATE_PATH=data/whisper-state.json
# Optional bis zum Dashboard-Cutover. Mit DATABASE_URL liest der Bot Orakel, Fragmente und Profilkarten aus PostgreSQL.
DATABASE_URL=
# Railway Bucket: per AWS-SDK-Preset aus sanctum-theoretica-assets übernehmen.
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual